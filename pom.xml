<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>games.crescentnetwork</groupId>
    <artifactId>PrefabMcp</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>PrefabMcp</name>
    <description>Hosts an MCP server so agentic harnesses can author Hytale prefabs</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- https://maven.hytale.com/release/com/hypixel/hytale/Server/maven-metadata.xml -->
        <hytale.server.version>0.6.2</hytale.server.version>
        <graaljs.version>24.1.2</graaljs.version>
        <junit.version>6.1.3</junit.version>
        <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>
        <maven.surefire.plugin.version>3.5.6</maven.surefire.plugin.version>
    </properties>

    <repositories>
        <repository>
            <id>hytale-release</id>
            <url>https://maven.hytale.com/release</url>
        </repository>
        <repository>
            <id>hytale-pre-release</id>
            <url>https://maven.hytale.com/pre-release</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
            The server jar is an uber-jar supplying Gson, BSON, JOML and fastutil, and the plugin
            classloader is parent-first, so none of those may be shaded: the server's copies win.
        -->
        <dependency>
            <groupId>com.hypixel.hytale</groupId>
            <artifactId>Server</artifactId>
            <version>${hytale.server.version}</version>
            <scope>provided</scope>
        </dependency>

<!--
            No script engine ships with the server, so one has to be bundled.

            GraalJS rather than Rhino: Rhino 1.8.0 and 1.8.1 both fail to re-evaluate a `const`
            declared inside a loop body, returning the first iteration's value forever, in every
            combination of interpreted/compiled mode and language version. Model-written build
            scripts use `const` in loops constantly, and the result is a silently wrong build with
            no error at all. Rhino's `let` also has no per-iteration closure capture. GraalJS gets
            both right. It costs about 58MB in the shaded jar, and ICU4J is a hard dependency that
            cannot be excluded (js-language fails to initialise without it).
        -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graaljs.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js-community</artifactId>
            <version>${graaljs.version}</version>
            <type>pom</type>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>manifest.json</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>manifest.json</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.graalvm.polyglot:*</include>
                                    <include>org.graalvm.js:*</include>
                                    <include>org.graalvm.regex:*</include>
                                    <include>org.graalvm.truffle:*</include>
                                    <include>org.graalvm.sdk:*</include>
                                    <include>org.graalvm.shadowed:*</include>
                                </includes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!--
                                            The plugin is loaded from a URLClassLoader on the
                                            classpath, never as a named module, and leaving the
                                            descriptors in makes Truffle try the module path first.
                                        -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
