// Shown by /prefab-mcp. Its job is to put the connection details somewhere a player can select and
// copy them, which chat does not allow.
//
// The two values that matter are in TextFields rather than Labels purely so they can be selected.
// Nothing is ever read back from them: editing one locally has no effect, and re-running the command
// restores it. Everything static is written here; Java only fills in the two values and decides
// whether the token section is shown.
$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    @CloseButton = true;
    Anchor: (Width: 620);

    #Title {
      $C.@Title {
        @Text = "Prefab MCP";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label {
        Anchor: (Bottom: 14, Left: 4, Right: 4);
        Text: "Add this to your MCP client configuration. Replace <server-host> with this server's address, or 127.0.0.1 if the agent runs on this machine.";
        Style: (...$C.@DefaultLabelStyle, Wrap: true);
      }

      Label {
        Anchor: (Bottom: 6, Left: 4);
        Text: "Configuration";
        Style: (...$C.@DefaultLabelStyle, RenderBold: true);
      }

      $C.@TextField #Config {
        @Anchor = (Left: 0, Right: 0, Bottom: 14);
      }

      Group #TokenSection {
        LayoutMode: Top;

        Label {
          Anchor: (Bottom: 6, Left: 4);
          Text: "Your personal token";
          Style: (...$C.@DefaultLabelStyle, RenderBold: true);
        }

        $C.@TextField #Token {
          @Anchor = (Left: 0, Right: 0, Bottom: 8);
        }

        Label {
          Anchor: (Bottom: 14, Left: 4, Right: 4);
          Text: "This token is personal to you. Anyone who has it can build on this server as you, so do not share it or paste it anywhere public.";
          Style: (...$C.@DefaultLabelStyle, Wrap: true);
        }
      }

      Label {
        Anchor: (Left: 4, Right: 4);
        Text: "Select a field and press Ctrl+C to copy. Editing a field here changes nothing; run /prefab-mcp again to restore it.";
        Style: (...$C.@DefaultLabelStyle, Wrap: true);
      }
    }
  }
}
